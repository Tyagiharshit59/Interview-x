# Copy to server/.env (the API loads it from its working directory) and adjust.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# REQUIRED in production: long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Storage (SQLite file + uploaded/recorded files). Use a persistent volume in production.
DB_PATH=../storage/app.db
STORAGE_DIR=../storage

# Super admin bootstrap. If the password is empty in development, a random one is generated and printed once.
SUPER_ADMIN_EMAIL=admin@intervuex.local
SUPER_ADMIN_PASSWORD=

# Email. Without SMTP_HOST, emails are written to the email_outbox table and printed in the dev console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@yourdomain.com

# WebRTC ICE servers (JSON). Add a TURN server for reliable connections behind strict NATs/firewalls.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Code execution: judge0 | dev-local | disabled
#  judge0    -> isolated Judge0 deployment (recommended; set JUDGE0_URL)
#  dev-local -> spawns node/python on this machine. NOT a sandbox. Refused when NODE_ENV=production.
CODE_RUNNER=disabled
JUDGE0_URL=
JUDGE0_API_KEY=

# Optional OpenAI-compatible provider for AI assistance (otherwise a labelled rule-based fallback is used)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Payments (India). Without keys, a development-only payment simulator is available outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_STATE=Karnataka
SELLER_GSTIN=
